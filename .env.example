DJANGO_DEBUG=0
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_COOKIES_SEGURAS=0
DJANGO_PROXY_SSL=0

DB_NAME=PintureriaDB
DB_HOST=db
DB_PORT=1433
# SQL Server exige 8+ caracteres con mayúsculas, minúsculas, números o símbolos.
DB_USER=app_django
DB_PASSWORD=App#Django2026
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes

# Contraseña de "sa" del contenedor de SQL Server (la usa manage.py inicializar_bd).
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=Pintureria#2026Sa

# Primer usuario gerente (solo se crea si no existe).
GERENTE_USUARIO=gerente
GERENTE_CONTRASENA=Clave-2026

DESCUENTO_CLAVE=cambiar

# Usuario de Docker Hub donde está la imagen compartida del equipo.
DOCKERHUB_USUARIO=sapopinturas
