# /etc/fail2ban/jail.local — servidor de producción (Dokploy)
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
# Agregar aquí la IP pública del equipo si no se quiere bloquear nunca:
ignoreip = 127.0.0.1/8 ::1

# Intentos de acceso por SSH
[sshd]
enabled = true
port    = ssh
mode    = aggressive

# Reincidentes: quien es bloqueado 3 veces en un día queda fuera una semana
[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
bantime  = 1w
findtime = 1d
maxretry = 3
